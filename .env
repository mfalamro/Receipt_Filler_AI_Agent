# .env is gitignored. On Streamlit Community Cloud there is no .env
# file, so paste these same three keys into the app's Secrets
# console instead: Streamlit exposes root-level secrets as
# environment variables, so os.getenv() finds them either way and
# the code needs no changes.
#
# No OpenAI key is needed here. The model runs inside n8n, so that
# credential lives in n8n.

# The webhook URL of the "Receipt Filler Agent" workflow.
N8N_GENERATE_WEBHOOK_URL=https://muneeraalamro.app.n8n.cloud/webhook/receipt-generate

# The webhook URL of the "Email Receipt" workflow. Leave empty to
# hide the emailing feature in the app.
N8N_EMAIL_WEBHOOK_URL=https://muneeraalamro.app.n8n.cloud/webhook/receipt-email

# Must match the value in the n8n Header Auth credential used by
# both webhooks. Invent a long random string.
N8N_API_KEY=X-API-Key.WiBaqoM0EXMJmhbx7i1VsivIA
